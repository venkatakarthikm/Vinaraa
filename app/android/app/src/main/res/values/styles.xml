<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#090714</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">#090714</item>
        <item name="android:statusBarColor">#090714</item>
        <item name="android:navigationBarColor">#090714</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#090714</item>
        <item name="android:statusBarColor">#090714</item>
        <item name="android:navigationBarColor">#090714</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#090714</item>
        <item name="android:windowBackground">#090714</item>
        <item name="android:statusBarColor">#090714</item>
        <item name="android:navigationBarColor">#090714</item>
        <item name="windowSplashScreenBackground">#090714</item>
    </style>
</resources>
