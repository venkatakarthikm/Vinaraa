<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/w_bg"
    android:padding="8dp">

    <ImageView
        android:id="@+id/w_vinyl_record"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_music_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#99000000"
        android:padding="6dp">

        <TextView
            android:id="@+id/w_vinyl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vinaraa"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_vinyl_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Song details"
            android:textColor="#CCCCCC"
            android:textSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_vinyl_play_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="4dp"
        android:src="@drawable/ic_play"
        android:padding="8dp" />
</RelativeLayout>
