# ─────────────────────────────────────────────────────────────
# SoundWave backend — environment
# Copy to .env and fill in. NEVER commit the real .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080

# ---------- Database (MongoDB Atlas free M0 works fine) ----------
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/soundwave?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/soundwave
MONGODB_MAX_POOL=10

# ---------- Auth / JWT ----------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_me_with_a_long_random_string_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ---------- Upstream JioSaavn API pool ----------
# Comma separated. The FIRST one is seeded on first boot; add/rotate more
# at runtime through /api/v1/admin/upstreams (protected by ADMIN_API_KEY).
UPSTREAM_URLS=https://jiosaavn-api.apicoolie.workers.dev
# Your worker serves routes under /api (e.g. /api/search/songs). Change if you redeploy differently.
UPSTREAM_PATH_PREFIX=/api
UPSTREAM_TIMEOUT_MS=9000
UPSTREAM_HEALTH_PATH=/search/songs?query=arijit%20singh&limit=1
UPSTREAM_COOLDOWN_MS=60000
UPSTREAM_MAX_FAILURES=3
# Extra resilience: your backend can fall back to public mirrors if ALL your own workers die.
# Leave empty to disable.
UPSTREAM_FALLBACK_URLS=
UPSTREAM_FALLBACK_PATH_PREFIX=/api

# ---------- Cache (in-memory LRU + MongoDB TTL tier, NO Redis) ----------
CACHE_MAX_ENTRIES=3000
CACHE_TTL_SEARCH=300
CACHE_TTL_SONG=1800
CACHE_TTL_ENTITY=3600
CACHE_TTL_STREAM_URL=600
CACHE_MONGO_TIER=true

# ---------- Rate limits ----------
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_MIN=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_WRITE_MAX=240
RATE_LIMIT_WRITE_WINDOW_MIN=15

# ---------- Security / CORS ----------
# Comma separated origins, or * for all (mobile clients don't send Origin anyway)
CORS_ORIGINS=*
ADMIN_API_KEY=replace_me_with_a_long_random_admin_key
TRUST_PROXY=1

# ---------- Recommendation engine weights (movie -> hero -> language -> singer -> director) ----------
RECO_W_MOVIE=0.30
RECO_W_HERO=0.22
RECO_W_LANGUAGE=0.18
RECO_W_SINGER=0.16
RECO_W_DIRECTOR=0.14
RECO_MIN_LISTEN_MS=30000
RECO_PLAY_RATIO=0.5

# ---------- Retention (TTL collections) ----------
TTL_PLAY_EVENTS_DAYS=180
TTL_SEARCH_HISTORY_DAYS=180
TTL_RAW_SESSION_DAYS=30
TTL_CACHE_DAYS=7

# ---------- Render free tier keep-alive (self ping to stop cold starts) ----------
# e.g. https://soundwave-api.onrender.com  — used by npm run keepalive
PUBLIC_BASE_URL=
KEEPALIVE_INTERVAL_MS=600000
