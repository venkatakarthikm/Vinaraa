    {
      "name": "10 · Admin (x-admin-key)",
      "item": [
        { "name": "List upstreams", "request": { "method": "GET", "header": [{ "key": "x-admin-key", "value": "{{adminKey}}" }], "url": "{{baseUrl}}/api/v1/admin/upstreams" } },
        {
          "name": "Add upstream (rotate worker URL)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const b = pm.response.json();", "if (b.data && b.data.upstream) pm.collectionVariables.set('upstreamId', b.data.upstream.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-admin-key", "value": "{{adminKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://my-new-worker.workers.dev\",\n  \"pathPrefix\": \"/api\",\n  \"priority\": 1,\n  \"notes\": \"replacement worker\"\n}" }, "url": "{{baseUrl}}/api/v1/admin/upstreams" }
        },
        { "name": "Patch upstream (disable / reprioritise)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-admin-key", "value": "{{adminKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"enabled\": false,\n  \"priority\": 99\n}" }, "url": "{{baseUrl}}/api/v1/admin/upstreams/{{upstreamId}}" } },
        { "name": "Delete upstream", "request": { "method": "DELETE", "header": [{ "key": "x-admin-key", "value": "{{adminKey}}" }], "url": "{{baseUrl}}/api/v1/admin/upstreams/{{upstreamId}}" } },
        { "name": "Health-check all upstreams", "request": { "method": "POST", "header": [{ "key": "x-admin-key", "value": "{{adminKey}}" }], "url": "{{baseUrl}}/api/v1/admin/upstreams/health-check" } },
        { "name": "Optimize pool order", "request": { "method": "POST", "header": [{ "key": "x-admin-key", "value": "{{adminKey}}" }], "url": "{{baseUrl}}/api/v1/admin/upstreams/optimize" } },
        { "name": "Upstream stats", "request": { "method": "GET", "header": [{ "key": "x-admin-key", "value": "{{adminKey}}" }], "url": "{{baseUrl}}/api/v1/admin/upstreams/stats" } },
        { "name": "Platform stats", "request": { "method": "GET", "header": [{ "key": "x-admin-key", "value": "{{adminKey}}" }], "url": "{{baseUrl}}/api/v1/admin/stats" } },
        { "name": "Users", "request": { "method": "GET", "header": [{ "key": "x-admin-key", "value": "{{adminKey}}" }], "url": "{{baseUrl}}/api/v1/admin/users?limit=20" } },
        { "name": "Ensure indexes", "request": { "method": "POST", "header": [{ "key": "x-admin-key", "value": "{{adminKey}}" }], "url": "{{baseUrl}}/api/v1/admin/maintenance/ensure-indexes" } },
        { "name": "Sweep cache", "request": { "method": "POST", "header": [{ "key": "x-admin-key", "value": "{{adminKey}}" }], "url": "{{baseUrl}}/api/v1/admin/maintenance/sweep-cache" } },
        { "name": "Reap stale sessions", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-admin-key", "value": "{{adminKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"maxAgeMinutes\": 30\n}" }, "url": "{{baseUrl}}/api/v1/admin/maintenance/reap-stale-sessions" } },
        { "name": "Refresh catalogue", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-admin-key", "value": "{{adminKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"limit\": 25\n}" }, "url": "{{baseUrl}}/api/v1/admin/maintenance/refresh-catalogue" } },
        { "name": "Rebuild system playlists", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-admin-key", "value": "{{adminKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"limit\": 50\n}" }, "url": "{{baseUrl}}/api/v1/admin/maintenance/rebuild-system-playlists" } },
        { "name": "Recompute trending", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-admin-key", "value": "{{adminKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"days\": 7\n}" }, "url": "{{baseUrl}}/api/v1/admin/maintenance/recompute-trending" } }
      ]
