        { "name": "Update settings", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"notificationsEnabled\": true,\n  \"liveActivityEnabled\": true\n}" }, "url": "{{baseUrl}}/api/v1/notifications/settings" } },
